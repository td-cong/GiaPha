@model GiaPha.Models.ThanhVien

@{
    ViewBag.Title = "Create2";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ThanhVienList = (List<GiaPha.Models.ThanhVien>)ViewBag.ThanhVienList;
    GiaPha.Models.GiaPhaEntities db = new GiaPha.Models.GiaPhaEntities();
}

@using (Html.BeginForm("Create2", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ID)

    <div class="form">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="row">
            <div class="form-group col-md-6">
                <strong>Họ tên</strong>
                @Html.DropDownListFor(model => model.ID, new SelectList(ThanhVienList, "ID", "HoTen"), "- Chọn -", new { @class = "form-control", @onchange = "GetMemberInfo()" })
                @Html.ValidationMessageFor(model => model.ID, "", new { @class = "text-danger" })
            </div>  
        </div>
        <div class="row">
            <div class="form-group col-md-6">
                <strong>ID Tài khoản</strong>
                @Html.EditorFor(model => model.IdTaiKhoan, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.IdTaiKhoan, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group my-3">
            <div class="col-md-12 text-center">
                <button type="submit" class="btn btn-primary"><i class="bi bi-floppy-fill"></i> Lưu</button>
                <a class="btn btn-secondary" href="@Url.Action("/Index")">Quay lại</a>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function GetMemberInfo() {
            var memberId = $("#ID").val();
            $.ajax({
                type: "GET",
                url: "/Account/GetMemberInfo",
                data: { id: memberId },
                success: function (data) {
                    $("#IdTaiKhoan").val(data.IdTaiKhoan);
                }
            });
        }
    </script>

}



