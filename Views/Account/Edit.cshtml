@model GiaPha.Models.Account

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var AccountList = (List<GiaPha.Models.Account>)ViewBag.AccountList;
    var isPopup = Request.QueryString["popup"] == "true";
    GiaPha.Models.GiaPhaEntities db = new GiaPha.Models.GiaPhaEntities();
}

<h4 class="my-3">Cập nhật thông tin tài khoản</h4>
<hr />
@using (Html.BeginForm("Edit", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ID)
    <input type="hidden" name="popup" value="@(isPopup)" />

    <div class="form">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row">
            <div class="form-group col-md-6">
                <strong>ID</strong>
                <span class="form-control">@Model.ID</span>
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <strong>User name</strong>
                @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <strong>Password</strong>
                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <strong>Tên</strong>
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <strong>ID Chức năng</strong>
                @*@Html.DropDownListFor(model => model.idChucNang, AccountList.Select(x => x.idChucNang).Distinct()
                .Select(x => new SelectListItem { Value = x.ToString(), Text = x.ToString() }),
                "- Chọn -", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.idChucNang, "", new { @class = "text-danger" })*@

                <select id="idChucNangDropdown" class="form-control" name="idChucNang">
                    <option value="">- Chọn -</option>
                    @foreach (var item in db.ChucNangs.Select(x => new { x.idChucNang, x.TenChucNang }).Distinct())
                    {
                        <option value="@item.idChucNang" data-tenchucnang="@item.TenChucNang">
                            @item.idChucNang
                        </option>
                    }
                </select>
                @Html.ValidationMessageFor(model => model.idChucNang, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <strong>Role</strong>
                @Html.EditorFor(model => model.Role, new { htmlAttributes = new { @class = "form-control", @id = "roleInput" } })
                @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger" })
            </div>

            <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
            <script>
                $(document).ready(function () {
                    $('#idChucNangDropdown').on('change', function () {

                    var selectedOption = $(this).find(':selected');
                    var tenChucNang = selectedOption.data('tenchucnang') || '';

                    // Đặt giá trị cho input Role
                    $('#roleInput').val(tenChucNang);
                    });
                });
            </script>
        </div>

        <div class="form-group my-3">
            <div class="col-md-12 text-center">
                <button type="submit" class="btn btn-primary"><i class="bi bi-floppy-fill"></i> Lưu</button>
                @if (isPopup == true)
                {
                    <a class="btn btn-secondary" href="javascript:window.close();">Đóng</a>
                }
                else
                {
                    <a class="btn btn-secondary" href="@Url.Action("/Index")">Quay lại</a>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

