@model GiaPha.Models.ThanhVienN

@{
    ViewBag.Title = "Edit2";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ThanhVienList = (List<GiaPha.Models.ThanhVienN>)ViewBag.ThanhVienList;
}

@using (Html.BeginForm("Edit2", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Sửa quyền truy cập</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ID)

        <div class="form-group">
            @Html.LabelFor(model => model.IdTaiKhoan, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.IdTaiKhoan, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.IdTaiKhoan, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary"><i class="bi bi-floppy-fill"></i> Lưu</button>
                <a class="btn btn-secondary" href="@Url.Action("/Index")">Quay lại</a>
            </div>
        </div>
    </div>
}