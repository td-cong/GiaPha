@model IEnumerable<GiaPha.Models.Account>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var AccountList = (List<GiaPha.Models.Account>)ViewBag.AccountList;
    GiaPha.Models.GiaPhaEntities db = new GiaPha.Models.GiaPhaEntities();
    var tktv = db.ThanhVienNs.Where(tv => tv.IdTaiKhoan != null).ToList();
}

<h4 class="my-3">Danh sách tài khoản</h4>
<hr />

<p>
    @Html.ActionLink("+ Thêm mới", "Create", null, new { @class = "btn btn-success" })
</p>
<table id="table" class="table table-bordered table-light table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th style="min-width: 50px">ID</th>
            <th style="min-width: 100px">Username</th>
            <th style="min-width: 150px">Password</th>
            <th style="min-width: 150px">Name</th>
            @*<th style="min-width: 150px">ID Chuc nang</th>*@
            <th style="min-width: 150px">Role</th>
            <th style="min-width: 70px"></th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Password)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            @*<td>
                @Html.DisplayFor(modelItem => item.idChucNang)
            </td>*@
            <td>
                @Html.DisplayFor(modelItem => item.Role)
            </td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.ID }, new { @class = "text-decoration-none" })
                @Html.ActionLink("Xóa", "Delete", new { id = item.ID }, new { @class = "text-decoration-none text-danger" })
            </td>
        </tr>
    }
</table>

<h4 class="my-3">Danh sách tài khoản thành viên </h4>
<hr />
<p>
    @Html.ActionLink("+ Thêm mới", "Create2", null, new { @class = "btn btn-success" })
</p>
<table id="table" class="table table-bordered table-light table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th style="min-width: 50px">ID</th>
            <th style="min-width: 100px">Họ tên</th>
            <th style="min-width: 150px">Năm sinh-Năm mất</th>
            <th style="min-width: 150px">Vai vế</th>
            <th style="min-width: 150px">ID Tài Khoản</th>
            <th style="min-width: 70px"></th>
        </tr>
    </thead>

    @foreach (var item in tktv)
    {
        
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HoTen)
            </td>
            <td>
                @(string.Join(" - ", new string[] { item.NamSinh?.ToString(), item.NamMat?.ToString() }))
            <td>
                @(item.IsTruongHo == true ? "Trưởng họ " : "")
                @(item.IsTruongChi == true ? "Trưởng chi " : "")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdTaiKhoan)
            </td>
            <td>
                @Html.ActionLink("Sửa", "Edit2", new { Id = item.ID }, new { @class = "text-decoration-none" })
                @Html.ActionLink("Xóa", "Delete2", new { Id = item.ID }, new { @class = "text-decoration-none text-danger" })
            </td>
        </tr>
    }
</table>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    var dataTable = new DataTable('#table', {
        language: {
            url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json'
        },
        dom: '<"top d-flex justify-content-between align-items-center"fp>rt<"bottom d-flex justify-content-between align-items-center"il><"clear">'
    });
</script>

