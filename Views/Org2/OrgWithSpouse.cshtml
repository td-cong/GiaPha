                <script>
                    document.getElementById("fullscreen-btn").addEventListener("click", function () {
                        let orgChart = document.querySelector('#chart-container');

                        if (!document.fullscreenElement) {
                            if (orgChart.requestFullscreen) {
                                orgChart.requestFullscreen();
                            } else if (orgChart.mozRequestFullScreen) {
                                orgChart.mozRequestFullScreen();
                            } else if (orgChart.webkitRequestFullscreen) {
                                orgChart.webkitRequestFullscreen();
                            } else if (orgChart.msRequestFullscreen) {
                                orgChart.msRequestFullscreen();
                            }

                            if (window.screen.orientation && window.innerWidth < window.innerHeight) {
                                window.screen.orientation.lock("landscape").catch(error => {
                                    console.log("Không thể xoay màn hình:", error);
                                });
                            }
                        } else {
                            if (document.exitFullscreen) {
                                document.exitFullscreen();
                            }

                            // 📌 Trả màn hình về dọc khi thoát fullscreen
                            if (window.screen.orientation) {
                                window.screen.orientation.unlock();
                            }
                        }
                    });
