            $('#visible-level-select').on('change', function () {
                var newVisibleLevel = parseInt($(this).val());
                oc.init({
                    'data': datasource,
                    'nodeTemplate': selectedNodeTemplate,
                    'nodeTitle': 'name',
                    'nodeContent': 'title',
                    'nodeID': 'id',
                    'visibleLevel': newVisibleLevel,
                    'toggleSiblingsResp': true,
                    'pan': true,
                    'zoom': true,
                    'zoomoutLimit': 0.05,
                    'zoominLimit': 3,
                    'createNode': function ($node, data) {

                    if (data.levelOffset == -1) {
                        $node.css({
                            'margin-top': (data.levelOffset * 65) + 'px',
                            '--top': (-11 - data.levelOffset * 70) + 'px',
                            '--height': (9 + data.levelOffset * 70) + 'px',
                            '--top-cross-point': (-13 - data.levelOffset * 70) + 'px',
                            '--height-cross-point': (11 + data.levelOffset * 70) + 'px',
                        });
                        $node.find('.title').css({
                            'background-color': 'orange',
                        })
                    }
                    //avt
                    /*$node.find('.title').append(`<img class="avatar" src="/Content/img/avt.jpg" crossorigin="anonymous"/>`);*/
                    $node.find('.content').prepend($node.find('.symbol'));

                    // VoChong
                    var existingNodeIds = $node.map(function (index, element) {
                        return $(element).attr('id');
                    }).get();

                    //
                    var contentText = $node.find('.content').text().trim();
                    if (contentText.includes('Trưởng Chi')) {
                        $node.find('.title').css('background-color', '@(truongChiColor)');
                    }
                    else if (contentText.includes('Trưởng Họ')) {
                        $node.find('.title').css('background-color', '@(truongHoColor)');
                        }
                    var genderText = $node.find('.gender').text().trim();
                    if (contentText.includes('Nam')) {
                        $node.addClass('lv11');
                        }
                },
                    'initCompleted': function () {
                        var $chartContainer = $('.orgchart');
                        /*$('.orgchart').addClass('noncollapsable');*/
                        $('.oc-export-btn').addClass('d-none');

                        $('#fake-export').on('click', () => {
                            const scrollValues = {
                                0: 125, 1: 0,
                                2: 0, 3: 0,
                                4: 15, 5: 35,
                                6: 50, 7: 65,
                                8: 80, 9: 90,
                                10: 110, 11: 120,
                                12: 125, 13: 130,
                                default: 0
                            };
                            const { [newVisibleLevel]: scrollTop = scrollValues.default } = scrollValues;
                            window.scrollTo(0, scrollTop);
                        });
                        const xValues = {
                            0: 2, 1: 2,
                            2: 2, 3: 2,
                            4: 2, 5: 2,
                            6: 2, 7: 2,
                            8: 2, 9: 1.62,
                            10: 1.27, 11: 1.076,
                            12: 1.057,
                            default: 1.053
                        };

                        const $this = $('.orgchart').find('.node').first();
                        const $chart = $this.closest('.orgchart');

                        const { [newVisibleLevel]: x = xValues.default } = xValues;

                        const newX = window.parseInt(-(($chart.outerWidth(true) / x) - ($this.offset().left - $chart.offset().left) - ($this.outerWidth(true) / 2)));
                        const newY = window.parseInt(-($chart.outerHeight(true) / 4) - ($this.offset().top - $chart.offset().top));
                        $chart.css('transform', `matrix(0.5, 0, 0, 0.5, ${newX}, ${newY})`);

                    },
                });
            });

            @*$('.orgchart').append('@foreach (var item in voChong) {<div class="node" id="@item.ID" data-parent="@item.VoChong"><div class="title">@item.HoTen</div><div class="content"></div></div>}');*@

            oc.setChartScale(oc.$chart, 0.5);

            //highlight
            oc.$chart.find('.node')
                .on('mouseenter', function () {
                    $(this).addClass('highlight-self');
                })
                .on('mouseleave', function () {
                    oc.$chart.find('.node').removeClass('highlight-self');
                });

            $('#btn-filter-node').on('click', function () {
                filterNodes($('#key-word').val());

            });

            const levelSelect = document.getElementById('visible-level-select');
            $('#btn-cancel').on('click', function (data) {
                $('#key-word').val('');
                /*resetChart();*/
                const selectedLevel = parseInt(levelSelect.value);
                /*oc.init({ 'visibleLevel': selectedLevel });*/
                console.log(selectedLevel)
                const xValues = {
                    0: 1.83, 1: 2.55,
                    2: 2.6, 3: 2.7,
                    4: 3.1, 5: 3.1,
                    6: 3.4, 7: 3.6,
                    8: 3.7, 9: 2.63,
                    10: 1.83, 11: 1.465,
                    12: 1.432,
                    20: 1.83,
                    default: 1.426
                };

                const $this = $('.orgchart').find('.node').first();
                const $chart = $this.closest('.orgchart');

                /*const { [selectedLevel]: x = xValues.default } = xValues;*/
                const x = isNaN(selectedLevel) ? 2 : xValues[selectedLevel] ?? xValues.default;

                const newX = window.parseInt(-(($chart.outerWidth(true) / x) - ($this.offset().left - $chart.offset().left) - ($this.outerWidth(true) / 2)));
                const newY = window.parseInt(-($chart.outerHeight(true) / 4) - ($this.offset().top - $chart.offset().top));

                $chart.css('transform', `matrix(0.5, 0, 0, 0.5, ${newX}, ${newY})`);
            });

                $('#key-word').on('keyup', function (event) {
                if (event.which === 13) {
                    filterNodes(this.value);
                } else if (event.which === 8 && this.value.length === 0) {
                    levelSelect == 13;
                    /*clearFilterResult();*/
                    resetChart();
                }
            });

            //Form thông tin thanh viên
            var currentNodeId = null;
            oc.$chartContainer.on('click', '.node', function () {
                var $this = $(this);
