                var gender = $this.find('.gender').text();
                var birth = $this.find('.birth').text();
                var avtUrl = $this.find('img.avt').attr('src');
                var role = $this.find('.content').text().trim();

                var currentUserId = '@(currentUser != null && currentAccount != null ? currentAccount.ID : null)';

                if (currentNodeId !== nodeId) {
                    currentNodeId = nodeId; // Update current node ID
                    $('#node-info-form').css('display', 'unset');
                }

                if (currentNodeId === currentUserId) {
                    // Nếu trùng thì hiện nút edit
                    $('#info-edit').show();
                } else {
                    // Nếu không trùng thì ẩn nút edit
                    $('#info-edit').css('display', 'none');
                }

                var childNodes = $this.closest('.hierarchy').parents('.hierarchy').children('.node'); // Get child nodes
                var hasChildWithEditPermission = childNodes.filter(function () {
                    return $(this).attr('id') === currentUserId;
                }).length > 0;

                if (hasChildWithEditPermission) {
                    $('#info-edit').show();
                }

                oc.$chartContainer.on('click', '.orgchart', function (event) {
                    if (!$(event.target).closest('.node').length) {
                        $('#node-info-form').css('display', 'none');
                    }
                });

                $('#node-name').text(name).data('node', $this);
                $('#avatar-image').attr('src', avtUrl).data('node', $this);
                $('#input-name').val(`${name}`).data('node', $this);
                $('#input-gender').val(`${gender}`).data('node', $this);
                $('#input-birth').val(`${birth}`).data('node', $this);

                if (role.includes('Trưởng Chi')) {
                    $('#isTruongChi').prop('checked', true);
                }
                else {
                    $('#isTruongChi').prop('checked', false);
                }
                if (role.includes('Trưởng Họ')) {
                    $('#isTruongHo').prop('checked', true);
                }
                else {
                    $('#isTruongHo').prop('checked', false);
                }

                $('#info-edit').on('click', function () {
                    window.open(`/ThanhViens/Edit/${currentNodeId}?popup=true`, "_blank", "popup=true")
                });

                $('#node-info-form').css('display', 'unset');
                console.log(currentNodeId)
            });

            //pdf
            $('#info-pdf').on('click', function () {
                $("#node-info-form").printThis({
                    debug: false,
                    importStyle: true,
                    printContainer: true,
                    removeInline: false,
                    copyTagClasses: true,
                    copyTagStyles: true,
                });
            });

            oc.$chartContainer.on('click', '.orgchart', function (event) {
                if (!$(event.target).closest('.node').length) {
                    $('#node-info-form').css('display', 'none');
                }
            });

