@model IEnumerable<GiaPha.Models.ThanhVien>
@{
    ViewBag.Title = "OrgWithSpouse";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allData = Model;
    var currentUser = (GiaPha.Models.Account)Session["User"];
    var quyenQuanLy = ViewBag.quyenQuanLy;
    var truongHoColor = "purple";
    var truongChiColor = "CornflowerBlue";
    var voChongColor = "orange";

    var currentUri = HttpContext.Current.Request.Url.AbsoluteUri ?? HttpContext.Current.Request.Url.Scheme + HttpContext.Current.Request.Url.Host + HttpContext.Current.Request.Path ?? "";
}
@{
    var currentAccount = currentUser != null
? currentUser.ThanhViens.FirstOrDefault(t => t.IdTaiKhoan == currentUser.ID)
: allData.FirstOrDefault();

    var truongHo = allData.FirstOrDefault(t => t.IsTruongHo == true);

    var conChau = allData.Where(x => x.ID != truongHo.ID);

    var voChong = conChau.Where(v =>
    {
        if (v.VoChong != null)
        {
            return allData.Any(a => a.ID == v.VoChong);
        }
        return false;
    });
}

