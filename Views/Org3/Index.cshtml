        <script orgchart type="text/javascript">
            @functions{
                string GetAllConChau (IEnumerable<GiaPha.Models.ThanhVien> allData,int parentID) {
                    var conChauStr = "";
                    var conChau = allData.Where(x => x.PID == parentID);
                    var voChong = allData.Where(x => x.VoChong == parentID);

                    var ketQua = conChau.Concat(voChong).ToList();

                    if (ketQua != null)
                    {
                        foreach(var item in conChau)
                        {
                            var levelOffset = item.VoChong != null ? -1 : 0;

                            conChauStr += $"{{" +
                                        $"  'id': \"{item.ID}\", " +
                                        $"  'name': \"{item.HoTen}\", " +
                                        $"  'namsinh': \"{item.NamSinh} {(item.NamMat != null ? "- " + item.NamMat : "")}\", " +
                                        $"  'title': \"{(item.IsTruongChi == true ? "Trưởng Chi" : "")} {(item.IsTruongHo == true ? "Trưởng Họ" : "")} \", " +
                                        $"  'gender': \"{(item.GioiTinh == true ? "Nam" : "Nữ")} \", " +
                                        $"  'avt': \"{item.Avt}\", " +
                                        $"  'spouse': \"{item.VoChong}\", " +
                                        $"  'levelOffset': {levelOffset}, " +
                                        $"  'children': [{GetAllConChau(allData, item.ID)}], " +
                                        $"  }},";
                        }
                    }
                    return conChauStr;
                }
            }

            function loopChart($hierarchy) {
                var $siblings = $hierarchy.children('.nodes').children('.hierarchy');
                if ($siblings.length) {
                    $siblings.filter(':not(.hidden)').first().addClass('first-shown')
                        .end().last().addClass('last-shown');
                }
                $siblings.each(function (index, sibling) {
                    loopChart($(sibling));
                });
            }

            function filterNodes(keyWord) {
                keyWord = keyWord.toLowerCase();
                if (!keyWord.length) {
                    window.alert('Nhập từ khóa cần tìm!');
                    return;
                } else {
                    var $chart = $('.orgchart');
                    // disable the expand/collapse feature
                    $chart.addClass('noncollapsable');
                    // distinguish the matched nodes and the unmatched nodes according to the given key word
                    $matchedNodes = $chart.find('.node').filter(function (index, node) {
                        var nodeMatched = $(node).text().toLowerCase().indexOf(keyWord) > -1;
                        return nodeMatched;
                    }).addClass('matched')
                        .closest('.hierarchy').parents('.hierarchy').children('.node').addClass('retained');

                    if ($matchedNodes.length === 0) {
                        window.alert('Không tìm thấy nút nào chứa từ khóa "' + keyWord + '"!');
                        return;
                    }
                    // hide the unmatched nodes
                    $chart.find('.matched,.retained').each(function (index, node) {
                        $(node).removeClass('slide-up')
                            .closest('.nodes').removeClass('hidden')
                            .siblings('.hierarchy').removeClass('isChildrenCollapsed');
                        var $unmatched = $(node).closest('.hierarchy').siblings().find('.node:first:not(.matched,.retained)')
                            .closest('.hierarchy').addClass('hidden');
                    });
                    // hide the redundant descendant nodes of the matched nodes
                    //$chart.find('.matched').each(function (index, node) {
                    //    if (!$(node).siblings('.nodes').find('.matched').length) {
                    //        $(node).siblings('.nodes').addClass('hidden')
                    //            .parent().addClass('isChildrenCollapsed');
                    //    }
                    //});
                    /*$('.orgchart').css('transform', `matrix(0.5, 0, 0, 0.5, -${$chart.width() / 3}, -${$chart.height() / 1.7})`);*/
                    var chartWidth = $chart.outerWidth(true);
                    var chartHeight = $chart.outerHeight(true);
                    var nodeWidth = $matchedNodes.outerWidth(true);
                    var nodeHeight = $matchedNodes.outerHeight(true);
                    var a = 0.3; // giá trị phóng to theo chiều ngang
                    var d = 0.3; // giá trị phóng to theo chiều dọc
                    var e = (chartWidth / 2) - (nodeWidth / 2) * a;
                    var f = (chartHeight / 2) - (nodeHeight / 2) * d;
                    $('.orgchart').css('transform', `matrix(${a}, 0, 0, ${d}, -${e}, -${f})`);
                    // loop chart and adjust lines
                    loopChart($chart.find('.hierarchy:first'));
                }
            }

            function clearFilterResult() {
                $('.orgchart')
                    .find('.node').removeClass('matched retained')
                    .end().find('.hidden, .isChildrenCollapsed, .first-shown, .last-shown').removeClass('hidden isChildrenCollapsed first-shown last-shown')
                    .end().find('.slide-up, .slide-left, .slide-right')/*.removeClass('slide-up slide-right slide-left')*/;
            }
            function resetChart() {
                let $chartContainer = $('.orgchart');
                // Reset zoom + pan

                var chartWidth = $chartContainer.outerWidth(true);
                var chartHeight = $chartContainer.outerHeight(true);
                var nodeWidth = $('.orgchart').find('.node').outerWidth(true);
                var nodeHeight = $('.orgchart').find('.node').outerHeight(true);
                var a = 0.4; //  phóng to theo chiều ngang
                var d = 0.4; //  phóng to theo chiều dọc
                var e = (chartWidth / 2) - (nodeWidth ) * a;
                var f = (chartHeight / 2) - (nodeHeight ) * d;
                $('.orgchart').css('transform', `matrix(${a}, 0, 0, ${d}, -${e}, -${f})`);
            }

            $(function () {
            var datascource = {
                'id': `@{@Html.Raw(truongHo?.ID)}`,
                'name': `@{@Html.Raw(truongHo?.HoTen)<br/>}`,
                'namsinh': parseInt('@truongHo.NamSinh') || "" + ( parseInt('@truongHo.NamMat') || ""),
                'title': `@(truongHo?.IsTruongHo ?? true ? "Trưởng Họ" : "")`,
                'gender': `@(truongHo?.GioiTinh ?? true ? "Nam" : "Nữ")`,
                'avt': `@{@Html.Raw(truongHo?.Avt)}`,
                'spouse': `@{@Html.Raw(truongHo?.VoChong)}`,
                'children': [
                    @Html.Raw(GetAllConChau(allData, truongHo.ID))
                ],
                };
                console.log(datascource)

            var nodeTemplate = function (data) {
            /*var imgUrl = data.avt;*/
            var imgUrl = data.avt || '/Content/img/avt.jpg';
            return `

                <div class="title">
                    <img class="avt" crossorigin="anonymous" src="${imgUrl}"/>
                    <div class="name">${data.name}</div>
                    <div class="birth">${data.namsinh}</div>
                </div>
                <div class="content">${data.title}
                    <div class="gender">${data.gender}</div>
                </div>
                `;
                };

            var oc = $('#chart-container').orgchart({
                'exportButton': true,
                'exportButtonName': 'Xuất file',
                'exportFilename': 'OrgChart',
                'exportFileextension': 'png',
                'data': datascource,
                'nodeTemplate': nodeTemplate,
                'nodeTitle': 'name',
                'nodeContent': 'title',
                'nodeID': 'id',
                'visibleLevel': 10,
                /*'verticalLevel': 12,*/
                /*'toggleSiblingsResp': true,*/
                'pan': true,
                'zoom': true,
                'zoomoutLimit': 0.1,


                //'compact': function (data) {
                //    return data?.children?.length >= 3;
                //},

                'createNode': function ($node, data) {
                if (data.levelOffset == -1) {
                    $node.css({
                        'margin-top': (data.levelOffset * 65) + 'px',
                        '--top': (-11 - data.levelOffset * 70) + 'px',
                        '--height': (9 + data.levelOffset * 70) + 'px',
                        '--top-cross-point': (-13 - data.levelOffset * 70) + 'px',
                        '--height-cross-point': (11 + data.levelOffset * 70) + 'px',
                });
                    $node.find('.title').css({
                        'background-color': 'orange'
                    })
                }
                //avt
                /*$node.find('.title').append(`<img class="avatar" src="/Content/img/avt.jpg" crossorigin="anonymous"/>`);*/
                $node.find('.content').prepend($node.find('.symbol'));

                // VoChong
                var existingNodeIds = $node.map(function (index, element) {
                    return $(element).attr('id');
                }).get();

                //
                var contentText = $node.find('.content').text().trim();
                if (contentText.includes('Trưởng Chi')) {
                    $node.find('.title').css('background-color', '@(truongChiColor)');
                }
                else if (contentText.includes('Trưởng Họ')) {
                    $node.find('.title').css('background-color', '@(truongHoColor)');
                }
                },
                'initCompleted': function () {
                    resetChart()
                    var $chartContainer = $('.orgchart');
                    // Reset zoom + pan

                    /*$('.orgchart').addClass('noncollapsable');*/
                    $('.oc-export-btn').addClass('d-none');
                    $('#fake-export').on('click', () => {
                        $('.orgchart').css('transform', 'matrix(0.12, 0, 0, 0.12)');
                        setTimeout(() => {
                            $('.oc-export-btn').click();
                        }, 1000);
                    });
                },
            });

            $('#visible-level-select').on('change', function () {
                var newVisibleLevel = parseInt($(this).val());
                oc.init({
                    'data': datascource,
                    'nodeTemplate': nodeTemplate,
                    'nodeTitle': 'name',
                    'nodeContent': 'title',
                    'nodeID': 'id',
                    'visibleLevel': newVisibleLevel,
                    'toggleSiblingsResp': true,
                    'pan': true,
                    'zoom': true,
                    'zoomoutLimit': 0.1,
                    'createNode': function ($node, data) {
                    if (data.levelOffset == -1) {
                        $node.css({
                            'margin-top': (data.levelOffset * 65) + 'px',
                            '--top': (-11 - data.levelOffset * 70) + 'px',
                            '--height': (9 + data.levelOffset * 70) + 'px',
                            '--top-cross-point': (-13 - data.levelOffset * 70) + 'px',
                            '--height-cross-point': (11 + data.levelOffset * 70) + 'px',
                        });
                        $node.find('.title').css({
                            'background-color': 'orange',
                        })
                    }
                    //avt
                    /*$node.find('.title').append(`<img class="avatar" src="/Content/img/avt.jpg" crossorigin="anonymous"/>`);*/
                    $node.find('.content').prepend($node.find('.symbol'));

                    // VoChong
                    var existingNodeIds = $node.map(function (index, element) {
                        return $(element).attr('id');
                    }).get();

                    //
                    var contentText = $node.find('.content').text().trim();
                    if (contentText.includes('Trưởng Chi')) {
                        $node.find('.title').css('background-color', '@(truongChiColor)');
                    }
                    else if (contentText.includes('Trưởng Họ')) {
                        $node.find('.title').css('background-color', '@(truongHoColor)');
                    }
                },
                    'initCompleted': function () {
                        var $chartContainer = $('.orgchart');
                        /*resetChart()*/
                        /*$('.orgchart').addClass('noncollapsable');*/
                        $('.oc-export-btn').addClass('d-none');
                        $('#fake-export').on('click', () => {
                            $('.orgchart').css('transform', 'matrix(0.15, 0, 0, 0.15)');
                            setTimeout(() => {
                                $('.oc-export-btn').click();
                            }, 500);
                        });

                        if ( newVisibleLevel < 4 ) {
                            var $this = $('.orgchart').find('.node').first();
                            var $chart = $this.closest('.orgchart');    
                            var newX = window.parseInt(($chart.outerWidth(true) / 2) - ($this.offset().left - $chart.offset().left) - ($this.outerWidth(true) / 2));
                            var newY = window.parseInt(($chart.outerHeight(true) / 2) - ($this.offset().top - $chart.offset().top) - ($this.outerHeight(true) / 2));
                            $chart.css('transform', 'matrix(0.5, 0, 0, 0.5, ' + newX + ', ' + newY + ')');
                        } else { $('.orgchart').css('transform', `matrix(0.4, 0, 0, 0.4, -${$chartContainer.width() / 2.25}, -${$chartContainer.height() / 4})`); }
                    },
                });
            });

            @*$('.orgchart').append('@foreach (var item in voChong) {<div class="node" id="@item.ID" data-parent="@item.VoChong"><div class="title">@item.HoTen</div><div class="content"></div></div>}');*@

            oc.setChartScale(oc.$chart, 0.5);

            //highlight
            oc.$chart.find('.node')
                .on('mouseenter', function () {
                    $(this).addClass('highlight-self');
                })
                .on('mouseleave', function () {
                    oc.$chart.find('.node').removeClass('highlight-self');
                });

            $('#btn-filter-node').on('click', function () {
                filterNodes($('#key-word').val());
                let $chartContainer = $('.orgchart');

            });

            $('#btn-cancel').on('click', function () {
                clearFilterResult();
                $('#key-word').val('');
                resetChart();
            });

            $('#key-word').on('keyup', function (event) {
                if (event.which === 13) {
                    filterNodes(this.value);
                } else if (event.which === 8 && this.value.length === 0) {
                    clearFilterResult();
                    resetChart();
                }
            });

            //Form thông tin thanh viên
            var currentNodeId = null;
            oc.$chartContainer.on('click', '.node', function () {
                var $this = $(this);
                var nodeId = $this.attr('id');
                var name = $this.find('.name').text();
                var gender = $this.find('.gender').text();
                var birth = $this.find('.birth').text();
                var avtUrl = $this.find('img.avt').attr('src');
                var role = $this.find('.content').text().trim();

                if (currentNodeId !== nodeId) {
                    currentNodeId = nodeId; // Update current node ID
                    $('#node-info-form').css('display', 'unset');
                }

                oc.$chartContainer.on('click', '.orgchart', function (event) {
                    if (!$(event.target).closest('.node').length) {
                        $('#node-info-form').css('display', 'none');
                    }
                });

                $('#node-name').text(name).data('node', $this);
                $('#avatar-image').attr('src', avtUrl).data('node', $this);
                $('#input-name').val(`${name}`).data('node', $this);
                $('#input-gender').val(`${gender}`).data('node', $this);
                $('#input-birth').val(`${birth}`).data('node', $this);

                if (role.includes('Trưởng Chi')) {
                    $('#isTruongChi').prop('checked', true);
                }
                else {
                    $('#isTruongChi').prop('checked', false);
                }
                if (role.includes('Trưởng Họ')) {
                    $('#isTruongHo').prop('checked', true);
                }
                else {
                    $('#isTruongHo').prop('checked', false);
                }

                $('#info-edit').on('click', function () {
                    window.open(`/ThanhViens/Edit/${currentNodeId}?popup=true`, "_blank", "popup=true")
                });

                $('#node-info-form').css('display', 'unset');
                console.log(currentNodeId)
            });

            //pdf
            $('#info-pdf').on('click', function () {
                $("#node-info-form").printThis({
                    debug: false,
                    importStyle: true,
                    printContainer: true,
                    removeInline: false,
                    copyTagClasses: true,
                    copyTagStyles: true,
                });
            });

            oc.$chartContainer.on('click', '.orgchart', function (event) {
                if (!$(event.target).closest('.node').length) {
                    $('#node-info-form').css('display', 'none');
                }
            });

                var firstNode = $('.orgchart').find('.node').first();

                console.log('First:', firstNode)




